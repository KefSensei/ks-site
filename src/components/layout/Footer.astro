---
import logoNegative from '@/assets/logo/logo-negative.png';

const year = new Date().getFullYear();
---

<footer class="bg-[#1A1210] text-white/80 pt-16 pb-8">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 pb-12 border-b border-white/10 justify-items-center">

      <!-- Brand -->
      <div class="flex flex-col items-center text-center space-y-4">
        <img
          src={logoNegative.src}
          alt="Kef Sensei"
          class="h-16 w-auto object-contain"
          loading="lazy"
        />
        <p class="text-sm leading-relaxed text-white/60">
          Game Development Studio<br />
          <span class="font-bold text-white/80">Mastering FUN</span> since 2007
        </p>
      </div>

      <!-- Nav links -->
      <div class="text-center">
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">Navigate</h3>
        <ul class="space-y-2 list-none m-0 p-0">
          {[
            { href: '/#services',  label: 'Services' },
            { href: '/#portfolio', label: 'Our Work' },
            { href: '/#about',     label: 'About Us' },
            { href: '/#contact',   label: 'Contact' },
          ].map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-white/60 hover:text-[#FE953A] transition-colors no-underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="text-center">
        <h3 class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">Get in Touch</h3>
        <a
          href="mailto:info@kefsensei.com"
          class="text-sm text-white/60 hover:text-[#FE953A] transition-colors no-underline block mb-2"
        >
          info@kefsensei.com
        </a>
        <p class="text-sm text-white/40 mt-4">
          Have a game idea or project?<br />
          We'd love to hear from you.
        </p>
        <!-- Social icons -->
        <div class="flex items-center justify-center gap-4 mt-5">
          <a href="https://x.com/kefsensei" target="_blank" rel="noopener noreferrer"
             aria-label="Kef Sensei on X"
             class="text-white/30 hover:text-[#FE953A] transition-colors">
            <!-- X / Twitter -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.737-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://www.facebook.com/kefsensei/" target="_blank" rel="noopener noreferrer"
             aria-label="Kef Sensei on Facebook"
             class="text-white/30 hover:text-[#FE953A] transition-colors">
            <!-- Facebook -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073C24 5.406 18.627 0 12 0S0 5.406 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.235 2.686.235v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.269h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
            </svg>
          </a>
          <a href="https://www.instagram.com/kefsensei_funmasters/" target="_blank" rel="noopener noreferrer"
             aria-label="Kef Sensei on Instagram"
             class="text-white/30 hover:text-[#FE953A] transition-colors">
            <!-- Instagram -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/30">
      <p>&copy; {year} Kef Sensei. All rights reserved.</p>
      <div class="flex items-center gap-5">
        <a href="/privacy-policy" class="hover:text-white/60 transition-colors no-underline">Privacy Policy</a>
        <span class="text-white/15">|</span>
        <a href="/terms-of-use" class="hover:text-white/60 transition-colors no-underline">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>
