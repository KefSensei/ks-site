---
import logoV04 from '@/assets/logo/logo-v04.png';
---

<nav
  id="main-nav"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style="background: rgba(250,250,248,0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom: 1px solid rgba(230,57,70,0.08);"
>
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" aria-label="Kef Sensei — Home">
      <img
        src={logoV04.src}
        alt="Kef Sensei"
        height="40"
        class="h-10 w-auto object-contain"
        loading="eager"
      />
    </a>

    <!-- Desktop nav links -->
    <ul class="hidden md:flex items-center gap-8 list-none m-0 p-0">
      {[
        { href: '/#services',  label: 'Services' },
        { href: '/#portfolio', label: 'Our Work' },
        { href: '/#about',     label: 'About' },
      ].map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="text-sm font-semibold text-[#5C4A3A] hover:text-[#FE953A] transition-colors duration-200 no-underline"
          >
            {label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="/#contact"
          class="inline-flex items-center px-5 py-2 rounded-full text-sm font-bold text-white transition-all duration-200 hover:opacity-90 hover:-translate-y-px"
          style="background: linear-gradient(135deg, #E63946 0%, #FE953A 100%);"
        >
          Contact Us
        </a>
      </li>
    </ul>

    <!-- Mobile hamburger (CSS-only disclosure) -->
    <label
      for="nav-toggle"
      class="md:hidden cursor-pointer flex flex-col gap-1.5 p-2"
      aria-label="Toggle menu"
    >
      <span class="block w-6 h-0.5 bg-[#1A1210] transition-all duration-300 nav-bar-1"></span>
      <span class="block w-6 h-0.5 bg-[#1A1210] transition-all duration-300 nav-bar-2"></span>
      <span class="block w-6 h-0.5 bg-[#1A1210] transition-all duration-300 nav-bar-3"></span>
    </label>
  </div>

  <!-- Mobile menu (hidden checkbox trick) -->
  <input type="checkbox" id="nav-toggle" class="hidden peer" />
  <div class="hidden peer-checked:block md:hidden border-t border-orange-100 bg-[#FAFAF8]">
    <ul class="flex flex-col gap-0 list-none m-0 p-0 px-6 py-4">
      {[
        { href: '/#services',  label: 'Services' },
        { href: '/#portfolio', label: 'Our Work' },
        { href: '/#about',     label: 'About' },
        { href: '/#contact',   label: 'Contact Us' },
      ].map(({ href, label }) => (
        <li>
          <a
            href={href}
            class="block py-3 text-base font-semibold text-[#1A1210] hover:text-[#FE953A] transition-colors border-b border-orange-50 no-underline"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<!-- Offset for fixed nav -->
<div class="h-16"></div>
