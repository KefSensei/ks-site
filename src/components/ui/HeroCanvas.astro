<!-- Three.js particle canvas — Layer 0 of the hero section -->
<canvas
  id="hero-canvas"
  class="absolute inset-0 w-full h-full"
  style="z-index: 1; pointer-events: none;"
  aria-hidden="true"
></canvas>

<script>
import * as THREE from 'three';

const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const isMobile = window.innerWidth < 768;

if (reduced || isMobile) {
  document.getElementById('hero-canvas')?.remove();
} else {
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('hero-canvas not found');

  // ── Renderer ─────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: false });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
  renderer.setSize(canvas.offsetWidth, canvas.offsetHeight, false);

  // ── Scene / Camera ───────────────────────────────────
  const scene  = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, canvas.offsetWidth / canvas.offsetHeight, 0.1, 1000);
  camera.position.z = 55;

  // ═══════════════════════════════════════════════════════
  // EMBER STREAM — warm particles rising upward
  // ═══════════════════════════════════════════════════════
  const EMBER_COUNT = 120;
  const Y_BOTTOM    = -38;
  const Y_TOP       =  38;
  const Y_RANGE     = Y_TOP - Y_BOTTOM;

  const emberPositions  = new Float32Array(EMBER_COUNT * 3);
  const emberColors     = new Float32Array(EMBER_COUNT * 3);
  const emberSizes      = new Float32Array(EMBER_COUNT);
  const emberAlphas     = new Float32Array(EMBER_COUNT);
  // [i*2]   = vy (upward speed, units/frame)
  // [i*2+1] = wobble phase offset
  const emberVelocities = new Float32Array(EMBER_COUNT * 2);

  const emberPalette = [
    new THREE.Color('#FF6B1A'),
    new THREE.Color('#FF9233'),
    new THREE.Color('#FFB347'),
    new THREE.Color('#E63946'),
    new THREE.Color('#FFF0C8'),
    new THREE.Color('#FF4500'),
  ];

  for (let i = 0; i < EMBER_COUNT; i++) {
    // Spread initial Y so the system looks populated on load
    const startY = Y_BOTTOM + Math.random() * Y_RANGE;
    emberPositions[i * 3]     = (Math.random() - 0.5) * 100;
    emberPositions[i * 3 + 1] = startY;
    emberPositions[i * 3 + 2] = (Math.random() - 0.5) * 40;

    const c = emberPalette[Math.floor(Math.random() * emberPalette.length)];
    emberColors[i * 3]     = c.r;
    emberColors[i * 3 + 1] = c.g;
    emberColors[i * 3 + 2] = c.b;

    emberSizes[i] = Math.random() * 2.5 + 1.0;

    // Slower speed: 0.015–0.045 units/frame (was 0.03–0.11)
    emberVelocities[i * 2]     = Math.random() * 0.03 + 0.015;
    emberVelocities[i * 2 + 1] = Math.random() * Math.PI * 2;

    const yNorm   = (startY - Y_BOTTOM) / Y_RANGE;
    const fi      = Math.min(1, yNorm / 0.18);
    const fo      = Math.min(1, (1 - yNorm) / 0.18);
    emberAlphas[i] = Math.min(fi, fo);
  }

  const emberGeo = new THREE.BufferGeometry();
  emberGeo.setAttribute('position', new THREE.BufferAttribute(emberPositions, 3));
  emberGeo.setAttribute('color',    new THREE.BufferAttribute(emberColors,    3));
  emberGeo.setAttribute('size',     new THREE.BufferAttribute(emberSizes,     1));
  emberGeo.setAttribute('aAlpha',   new THREE.BufferAttribute(emberAlphas,    1));

  const emberMat = new THREE.ShaderMaterial({
    uniforms: { uOpacity: { value: 0.0 } },
    vertexShader: `
      attribute float size;
      attribute vec3  color;
      attribute float aAlpha;
      varying vec3    vColor;
      varying float   vAlpha;
      void main() {
        vColor = color;
        vAlpha = aAlpha;
        vec4 mv = modelViewMatrix * vec4(position, 1.0);
        gl_PointSize = size * (300.0 / -mv.z);
        gl_Position  = projectionMatrix * mv;
      }
    `,
    fragmentShader: `
      uniform float uOpacity;
      varying vec3  vColor;
      varying float vAlpha;
      void main() {
        float d    = length(gl_PointCoord - vec2(0.5));
        if (d > 0.5) discard;
        float core = smoothstep(0.5, 0.05, d);
        float glow = smoothstep(0.5, 0.25, d) * 0.35;
        float alpha = (core + glow) * uOpacity * vAlpha;
        gl_FragColor = vec4(vColor, alpha);
      }
    `,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
  });

  const emberPoints = new THREE.Points(emberGeo, emberMat);
  scene.add(emberPoints);

  // Fade in to 0.42 — transparent enough not to compete with text
  let emberOpacity = 0;
  setTimeout(() => {
    const ef = setInterval(() => {
      emberOpacity = Math.min(emberOpacity + 0.012, 0.42);
      emberMat.uniforms.uOpacity.value = emberOpacity;
      if (emberOpacity >= 0.42) clearInterval(ef);
    }, 30);
  }, 600);

  // ── Mouse parallax ────────────────────────────────────
  let mx = 0, my = 0, targetMx = 0, targetMy = 0;
  window.addEventListener('mousemove', (e) => {
    targetMx = (e.clientX / window.innerWidth  - 0.5) * 2;
    targetMy = (e.clientY / window.innerHeight - 0.5) * 2;
  });

  // ── Animation loop ────────────────────────────────────
  let frame = 0;
  const posAttr   = emberGeo.attributes.position as THREE.BufferAttribute;
  const alphaAttr = emberGeo.attributes.aAlpha   as THREE.BufferAttribute;

  function animate() {
    requestAnimationFrame(animate);
    frame++;

    mx += (targetMx - mx) * 0.04;
    my += (targetMy - my) * 0.04;

    // Ember stream: drift upward
    for (let i = 0; i < EMBER_COUNT; i++) {
      const vy    = emberVelocities[i * 2];
      const phase = emberVelocities[i * 2 + 1];

      let y = posAttr.getY(i) + vy;
      let x = posAttr.getX(i) + Math.sin(frame * 0.018 + phase) * 0.018;
      const z = posAttr.getZ(i);

      if (y > Y_TOP) {
        y = Y_BOTTOM + Math.random() * 4;
        x = (Math.random() - 0.5) * 100;
      }

      posAttr.setXYZ(i, x, y, z);

      const yNorm = (y - Y_BOTTOM) / Y_RANGE;
      const fi    = Math.min(1, yNorm / 0.18);
      const fo    = Math.min(1, (1 - yNorm) / 0.18);
      alphaAttr.setX(i, Math.min(fi, fo));
    }

    posAttr.needsUpdate   = true;
    alphaAttr.needsUpdate = true;

    renderer.render(scene, camera);
  }
  animate();

  // ── Resize ────────────────────────────────────────────
  window.addEventListener('resize', () => {
    const w = canvas.offsetWidth, h = canvas.offsetHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  });
}
</script>
