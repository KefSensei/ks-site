---
import Badge from '@/components/ui/Badge.astro';
---

<section id="contact" class="relative section overflow-hidden" style="background: #0D0D0D;">
  <!-- Accent glows -->
  <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-48 pointer-events-none" style="background: radial-gradient(ellipse, rgba(230,57,70,0.12) 0%, transparent 70%);"></div>
  <div class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none" style="background: radial-gradient(ellipse at 70% 100%, rgba(254,149,58,0.08) 0%, transparent 60%);"></div>

  <div class="max-w-3xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-10 reveal-up">
      <Badge variant="orange">Start a Conversation</Badge>
      <h2 class="text-4xl lg:text-5xl font-black mt-4 mb-4" style="font-family: var(--font-display); color: #FFFFFF;">
        Got a Game Idea?<br />
        <span style="background: linear-gradient(135deg, #E63946 0%, #FE953A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          Let's Make It Real.
        </span>
      </h2>
      <p class="text-base max-w-xl mx-auto leading-relaxed" style="color: rgba(255,255,255,0.55);">
        The best games start with a challenge worth solving. Tell us about yours —
        what you're building, what's blocking you, or just a wild idea you can't shake.
        We've turned plenty of napkin sketches into shipped FUN.
      </p>
      <a
        href="mailto:info@kefsensei.com"
        class="inline-flex items-center gap-2 mt-4 font-semibold hover:opacity-80 transition-opacity"
        style="color: #FE953A;"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="1" y="3" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
          <path d="M1.5 4L8 9.5L14.5 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
        info@kefsensei.com
      </a>
    </div>

    <!-- Form -->
    <div class="bg-white rounded-3xl p-8 lg:p-10 shadow-sm border border-[#E5E7EB] reveal-up" id="contact-form-wrapper">
      <form
        id="contact-form"
        action={`https://formspree.io/${import.meta.env.PUBLIC_FORMSPREE_ID}`}
        method="POST"
        class="space-y-5"
        novalidate
      >
        <!-- Name + Email -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-[#111111] mb-1.5">Your Name</label>
            <input
              type="text" id="name" name="name" required
              placeholder="Jane Smith"
              class="w-full px-4 py-3 rounded-xl border border-[#E5E7EB] bg-[#F9F9F9] text-[#111111] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:border-[#E63946] transition-all"
              style="--tw-ring-color: rgba(230,57,70,0.2);"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-[#111111] mb-1.5">Email Address</label>
            <input
              type="email" id="email" name="email" required
              placeholder="jane@studio.com"
              class="w-full px-4 py-3 rounded-xl border border-[#E5E7EB] bg-[#F9F9F9] text-[#111111] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:border-[#E63946] transition-all"
              style="--tw-ring-color: rgba(230,57,70,0.2);"
            />
          </div>
        </div>

        <!-- What are you looking for -->
        <div>
          <label for="service" class="block text-sm font-semibold text-[#111111] mb-1.5">What kind of help do you need?</label>
          <select
            id="service" name="service"
            class="w-full px-4 py-3 rounded-xl border border-[#E5E7EB] bg-[#F9F9F9] text-[#111111] focus:outline-none focus:ring-2 focus:border-[#E63946] transition-all"
            style="--tw-ring-color: rgba(230,57,70,0.2);"
          >
            <option value="">Select the closest match (optional)</option>
            <option value="co-development">Co-Development or Outsourcing</option>
            <option value="prototyping">Rapid Prototype / Proof of Concept</option>
            <option value="gamification">Gamification Design</option>
            <option value="work-for-hire">Work For Hire (feature or full project)</option>
            <option value="ai-dev">AI-Accelerated Development</option>
            <option value="consulting">Game Design Consulting</option>
            <option value="other">Not sure yet / Just exploring</option>
          </select>
        </div>

        <!-- Project stage -->
        <div>
          <label class="block text-sm font-semibold text-[#111111] mb-2">Where are you right now?</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="stage-group">
            {['Just an idea', 'Have a design doc', 'In development', 'Need production help'].map((stage) => (
              <label class="stage-option relative flex items-center justify-center text-center px-3 py-2.5 rounded-xl border border-[#E5E7EB] text-xs font-semibold text-[#4B5563] cursor-pointer transition-all hover:border-[#E63946] hover:text-[#E63946]">
                <input type="radio" name="stage" value={stage} class="sr-only" />
                {stage}
              </label>
            ))}
          </div>
        </div>

        <!-- Message -->
        <div>
          <label for="message" class="block text-sm font-semibold text-[#111111] mb-1.5">
            Tell us about your game or challenge
            <span class="font-normal text-[#9CA3AF] ml-1">(the wilder the better)</span>
          </label>
          <textarea
            id="message" name="message" required rows="5"
            placeholder="Example: 'I have a match-3 core loop that I want to wrap in a slot mechanic — can you prototype it in 2 weeks?' or 'We're halfway through production and need a feature team to unblock us...'"
            class="w-full px-4 py-3 rounded-xl border border-[#E5E7EB] bg-[#F9F9F9] text-[#111111] placeholder:text-[#9CA3AF] focus:outline-none focus:ring-2 focus:border-[#E63946] transition-all resize-none"
            style="--tw-ring-color: rgba(230,57,70,0.2);"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-4 rounded-2xl text-white font-bold text-base transition-all duration-200 hover:opacity-90 hover:-translate-y-0.5 active:translate-y-0 animate-glow-pulse"
          style="background: linear-gradient(135deg, #E63946 0%, #FE953A 100%);"
        >
          Send It Our Way
        </button>

        <p class="text-xs text-center text-[#9CA3AF]">We read every message and respond within 48 hours.</p>
      </form>

      <!-- Success state -->
      <div id="form-success" class="hidden text-center py-8 space-y-4">
        <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-full" style="background: linear-gradient(135deg, #E63946, #FE953A);">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 12l5 5L20 7" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-[#111111]" style="font-family: var(--font-display);">Message Received!</h3>
        <p class="text-[#4B5563]">We'll review your challenge and get back to you within 48 hours. Exciting stuff ahead.</p>
      </div>

      <!-- Error state -->
      <div id="form-error" class="hidden mt-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm text-center">
        Something went wrong. Email us directly at
        <a href="mailto:info@kefsensei.com" class="font-semibold underline">info@kefsensei.com</a>.
      </div>
    </div>
  </div>
</section>

<script>
  // Per-service textarea placeholder copy
  const SERVICE_PLACEHOLDERS: Record<string, string> = {
    '':               "Example: 'I have a match-3 core loop that I want to wrap in a slot mechanic — can you prototype it in 2 weeks?' or 'We're halfway through production and need a feature team to unblock us...'",
    'co-development': "Example: 'We need 2–3 senior devs for 4 months to build the backend systems for our casual mobile title — what's your bandwidth look like?'",
    'prototyping':    "Example: 'I have a slot mechanic concept and need a playable prototype in 2 weeks to pitch to publishers — what do you need from me to get started?'",
    'gamification':   "Example: 'We're adding a rewards loop to our fitness app — can you design the progression system and point economy so it actually feels like a game?'",
    'work-for-hire':  "Example: 'We're halfway through a hidden object game and need a feature team to own the hint system, UI polish, and level editor tool.'",
    'ai-dev':         "Example: 'We want LLM-driven procedural dialogue in our RPG — can you prototype an AI NPC system and advise on how to integrate it into our Unity pipeline?'",
    'consulting':     "Example: 'Our day-3 retention is falling off a cliff — we think the core loop is broken. Can you do a design review and give us actionable recommendations?'",
    'other':          "Tell us what's on your mind — no formal pitch needed. Just describe what you're building or exploring and we'll take it from there.",
  };

  const serviceSelect = document.getElementById('service') as HTMLSelectElement | null;
  const messageArea   = document.getElementById('message') as HTMLTextAreaElement | null;

  function updatePlaceholder() {
    if (!serviceSelect || !messageArea) return;
    messageArea.placeholder = SERVICE_PLACEHOLDERS[serviceSelect.value] ?? SERVICE_PLACEHOLDERS[''];
  }

  serviceSelect?.addEventListener('change', updatePlaceholder);

  // Pre-select from URL param (e.g. /?service=co-development#contact)
  const urlService = new URLSearchParams(window.location.search).get('service');
  if (urlService && serviceSelect) {
    serviceSelect.value = urlService;
    updatePlaceholder();
    // Clean the query string without reloading
    history.replaceState(null, '', window.location.pathname + '#contact');
  } else {
    updatePlaceholder();
  }

  // Stage radio pill styling
  document.querySelectorAll('.stage-option').forEach((label) => {
    const input = label.querySelector('input') as HTMLInputElement;
    input?.addEventListener('change', () => {
      document.querySelectorAll('.stage-option').forEach((l) => {
        l.setAttribute('style', '');
      });
      if (input.checked) {
        (label as HTMLElement).style.borderColor = '#E63946';
        (label as HTMLElement).style.color = '#E63946';
        (label as HTMLElement).style.background = 'rgba(230,57,70,0.06)';
      }
    });
  });

  // Form submit
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successEl = document.getElementById('form-success');
  const errorEl   = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const originalText = submitBtn.textContent || '';
    submitBtn.textContent = 'Sending…';
    submitBtn.disabled = true;
    errorEl?.classList.add('hidden');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        form.classList.add('hidden');
        successEl?.classList.remove('hidden');
      } else {
        throw new Error('Server error');
      }
    } catch {
      errorEl?.classList.remove('hidden');
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>
