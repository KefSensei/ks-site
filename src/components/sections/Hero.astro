---
import Button from '@/components/ui/Button.astro';

// Game scene images — dark collage backdrop (4×3 grid, staggered pulse)
const sceneBg = [
  '/assets/art-samples/SA_1.jpg',
  '/assets/art-samples/FR_main.png',
  '/assets/art-samples/HOG5.jpg',
  '/assets/art-samples/SA_3.jpg',
  '/assets/art-samples/VR_concept1.jpg',
  '/assets/art-samples/HOG6.jpg',
  '/assets/art-samples/FR_c1.png',
  '/assets/art-samples/DOM_store.jpg',
  '/assets/art-samples/HOG12.jpg',
  '/assets/art-samples/SA_5.jpg',
  '/assets/art-samples/VR_bgd_1.jpg',
  '/assets/art-samples/HOG14.jpg',
];

// Small gem / symbol sprites that float straight up (tight column floaters)
const gemSymbols = [
  { src: '/assets/game/symbol-ruby.png',       x: 4,  delay: 0,    dur: 13, size: 40 },
  { src: '/assets/game/symbol-emerald.png',    x: 11, delay: 2.5,  dur: 16, size: 28 },
  { src: '/assets/game/symbol-sapphire.png',   x: 22, delay: 1,    dur: 12, size: 46 },
  { src: '/assets/game/symbol-amethyst.png',   x: 35, delay: 4,    dur: 15, size: 34 },
  { src: '/assets/game/symbol-topaz.png',      x: 55, delay: 0.5,  dur: 17, size: 38 },
  { src: '/assets/game/symbol-potion.png',     x: 66, delay: 3,    dur: 14, size: 32 },
  { src: '/assets/game/symbol-crystal.png',    x: 76, delay: 1.5,  dur: 18, size: 44 },
  { src: '/assets/game/symbol-scatter.png',    x: 17, delay: 6.5,  dur: 19, size: 26 },
  { src: '/assets/game/symbol-mushroom.png',   x: 44, delay: 7,    dur: 13, size: 30 },
  { src: '/assets/game/symbol-bat.png',        x: 72, delay: 2,    dur: 16, size: 36 },
  { src: '/assets/game/symbol-multiplier.png', x: 88, delay: 8,    dur: 14, size: 28 },
];

// Larger character floaters — transparent PNGs, drift slowly up
const charFloaters = [
  // Sensei characters
  { src: '/assets/studio/sensei-ready-tp.png',      x: 80, delay: 0,   dur: 26, size: 160, rotate: 5  },
  { src: '/assets/studio/sensei-meditation-tp.png', x: 60, delay: 8,   dur: 30, size: 150, rotate: -4 },
  { src: '/assets/studio/sensei-welcome-tp.png',    x: 90, delay: 18,  dur: 24, size: 145, rotate: 6  },
  { src: '/assets/studio/sensei-students-tp.png',   x: 70, delay: 35,  dur: 28, size: 175, rotate: -3 },
  // Runner characters
  { src: '/assets/studio/runner-mage.png',          x: 85, delay: 4,   dur: 22, size: 110, rotate: 8  },
  { src: '/assets/studio/runner-ranger.png',        x: 55, delay: 14,  dur: 25, size: 105, rotate: -7 },
  { src: '/assets/studio/runner-tank.png',          x: 75, delay: 28,  dur: 23, size: 120, rotate: 4  },
  // Enanos (Finding Roxy dwarves — only fully transparent ones)
  { src: '/assets/studio/enano-1.png',              x: 65, delay: 6,   dur: 20, size: 120, rotate: -5 },
  { src: '/assets/studio/enano-1.png',              x: 53, delay: 38,  dur: 23, size: 110, rotate: 8  },
  // Roxy wild symbol — small accent
  { src: '/assets/game/symbol-roxy.png',            x: 48, delay: 10,  dur: 21, size: 80,  rotate: 10 },
];
---

<section id="hero" class="relative min-h-[90vh] flex items-center overflow-hidden" style="background: #0D0D0D;">

  <!-- Layer 1: Game scene collage (dark-tinted pulsing grid) -->
  <div class="absolute inset-0 scene-collage" aria-hidden="true">
    {sceneBg.map((src, i) => (
      <div
        class="scene-tile"
        style={`background-image: url('${src}'); animation-delay: ${i * 1.4}s;`}
      ></div>
    ))}
  </div>

  <!-- Layer 2: Dark overlay -->
  <div class="absolute inset-0" style="background: rgba(13,13,13,0.82);"></div>

  <!-- Layer 3a: Small gem symbols floating up -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    {gemSymbols.map((s) => (
      <img
        src={s.src}
        alt=""
        class="float-gem absolute"
        style={`left:${s.x}%;bottom:-60px;width:${s.size}px;height:${s.size}px;animation-duration:${s.dur}s;animation-delay:${s.delay}s;`}
      />
    ))}
  </div>

  <!-- Layer 3b: Larger character / icon floaters -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    {charFloaters.map((c) => (
      <img
        src={c.src}
        alt=""
        class="float-char absolute"
        style={`left:${c.x}%;bottom:-120px;width:${c.size}px;height:${c.size}px;animation-duration:${c.dur}s;animation-delay:${c.delay}s;--rot:${c.rotate}deg;`}
      />
    ))}
  </div>

  <!-- Layer 4: Radial grounding gradient (left side) -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 90% at 20% 60%, rgba(13,13,13,0.45) 0%, transparent 100%);"></div>

  <!-- Content -->
  <div class="max-w-6xl mx-auto px-6 w-full py-20 relative z-10">
    <div class="max-w-2xl space-y-7">

      <!-- Tag pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-bold border" style="background: rgba(230,57,70,0.15); border-color: rgba(230,57,70,0.4); color: #FE953A;">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E63946] inline-block animate-pulse"></span>
        Creating FUN since 2007
      </div>

      <!-- Headline -->
      <h1 class="text-6xl lg:text-7xl xl:text-8xl font-black leading-[0.9] tracking-tight" style="font-family: var(--font-display);">
        <span style="background: linear-gradient(135deg, #E63946 0%, #FE953A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          FUN
        </span><br />
        <span style="color: #FFFFFF;">Masters</span>
      </h1>

      <!-- Body copy -->
      <p class="text-lg leading-relaxed" style="color: rgba(255,255,255,0.72); max-width: 38rem;">
        For nearly two decades, Kef Sensei has been crafting games people genuinely love —
        shipping titles with global publishers, building original IPs, and treating every
        project like it's our own. A tight, senior team obsessed with one mission: deliver
        pure, relentless <strong style="color: #FE953A; font-weight: 700;">FUN</strong>.
      </p>
      <p class="text-base leading-relaxed" style="color: rgba(255,255,255,0.42); max-width: 36rem;">
        Wild concept? Mid-production and need trusted hands? Exploring AI for your pipeline?
        Tell us about your game — the best ones always start with a great conversation.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 pt-1">
        <Button href="/#contact" size="lg" glow>
          Share Your Idea
        </Button>
        <a
          href="/#portfolio"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-base font-bold border border-white/20 text-white/80 hover:border-white/50 hover:text-white transition-all"
        >
          See Our Games
        </a>
      </div>

      <!-- Stats -->
      <div class="flex gap-10 pt-5" style="border-top: 1px solid rgba(255,255,255,0.1);">
        {[
          { num: '19+', label: 'Years' },
          { num: '10+', label: 'Shipped Titles' },
          { num: '∞',   label: 'FUN Delivered' },
        ].map(({ num, label }) => (
          <div>
            <div class="text-3xl font-black leading-none" style="font-family: var(--font-display); background: linear-gradient(135deg, #E63946, #FE953A); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">{num}</div>
            <div class="text-xs font-bold uppercase tracking-wider mt-1" style="color: rgba(255,255,255,0.32);">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 pointer-events-none" style="background: linear-gradient(to bottom, transparent, #F4F4F5);"></div>
</section>

<style>
  /* ── Scene collage grid ───────────────────────────────────── */
  .scene-collage {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
  }

  .scene-tile {
    background-size: cover;
    background-position: center;
    animation: scenePulse 9s ease-in-out infinite alternate;
    filter: saturate(0.5) brightness(0.4);
  }

  @keyframes scenePulse {
    0%   { transform: scale(1);    filter: saturate(0.45) brightness(0.38); }
    100% { transform: scale(1.07); filter: saturate(0.7)  brightness(0.52); }
  }

  /* ── Small gem floaters ───────────────────────────────────── */
  @keyframes floatGem {
    0%   { transform: translateY(0)      rotate(0deg)   scale(0.8);  opacity: 0; }
    6%   { opacity: 0.55; }
    90%  { opacity: 0.4; }
    100% { transform: translateY(-108vh) rotate(25deg)  scale(1.05); opacity: 0; }
  }

  .float-gem {
    animation-name: floatGem;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    object-fit: contain;
    filter: drop-shadow(0 0 5px rgba(230,57,70,0.2));
  }

  /* ── Large character floaters ─────────────────────────────── */
  @keyframes floatChar {
    0%   { transform: translateY(0)      rotate(0deg)             scale(0.75); opacity: 0;    }
    8%   { opacity: 0.55; }
    80%  { opacity: 0.40; }
    100% { transform: translateY(-110vh) rotate(var(--rot, 8deg)) scale(1.05);  opacity: 0;   }
  }

  .float-char {
    animation-name: floatChar;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    object-fit: contain;
    filter: drop-shadow(0 4px 20px rgba(0,0,0,0.5));
  }

  @media (prefers-reduced-motion: reduce) {
    .scene-tile  { animation: none; }
    .float-gem   { animation: none; opacity: 0.08; }
    .float-char  { animation: none; opacity: 0.12; }
  }
</style>
