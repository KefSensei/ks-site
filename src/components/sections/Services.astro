---
import Badge from '@/components/ui/Badge.astro';

const services = [
  {
    num: '01',
    title: 'Co-Development & Outsourcing',
    summary: 'Your team, extended. We slot in and ship.',
    detail: "When your pipeline needs reinforcement, Kef Sensei integrates seamlessly with your existing team. We've shipped gameplay systems, feature modules, and full production support alongside major studios — speaking your tools, your engine, your process. No ramp-up drama, no rework cycles. Just senior talent that hits the ground running.",
    bullets: ['Gameplay systems & mechanics', 'Feature & content modules', 'Unity / Unreal / PixiJS / custom', 'Weekly milestones, transparent reporting'],
    audience: 'For studios that need trusted extra muscle without the hiring overhead.',
    svgPath: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75',
    color: '#E63946',
  },
  {
    num: '02',
    title: 'Rapid Prototyping',
    summary: 'Concept to playable. Fast.',
    detail: "We turn wild ideas into interactive proof-of-concepts in days — not months. Real iteration reveals real design problems early, validates mechanics before full investment, and gives stakeholders something they can actually play with. We have shipped investor-ready prototypes in under two weeks that went on to become full titles.",
    bullets: ['Concept to playable in 1–2 weeks', 'Mechanic & feel validation', 'Investor-ready demo builds', 'Iterative feedback loops'],
    audience: 'For founders, publishers, or designers who need to test an idea before betting big.',
    svgPath: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
    color: '#FE953A',
  },
  {
    num: '03',
    title: 'Gamification Design',
    summary: 'Turn anything into something people actually want to do.',
    detail: "Game design is not just for games. We apply progression systems, challenge loops, reward mechanics, and social hooks to loyalty programs, enterprise tools, training platforms, and digital products — creating systems that drive real behavior change, not just hollow check-the-box engagement.",
    bullets: ['Loyalty & reward system design', 'Learning & training gamification', 'User engagement architecture', 'KPI-driven mechanic design'],
    audience: 'For brands, EdTech, and product teams who want engagement that lasts.',
    svgPath: 'M6 9H4.5a2.5 2.5 0 010-5H6M18 9h1.5a2.5 2.5 0 000-5H18M4 22h16M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22M18 2H6v7a6 6 0 0012 0V2z',
    color: '#E63946',
  },
  {
    num: '04',
    title: 'Work For Hire',
    summary: 'Reliable delivery. Any scope. No surprises.',
    detail: "Need a proven team to own a defined piece of your project? We deliver specific features, gameplay systems, content pipelines, or end-to-end builds — adapting to your workflow and spec. We have shipped WFH contracts for PC, mobile, and web clients. Clear agreements, clean milestones, professional handoffs.",
    bullets: ['Feature-level to full-project scope', 'PC, mobile, browser platforms', 'Contract-based with milestone delivery', 'Long-term retainer available'],
    audience: 'For publishers and studios that need a reliable long-term production partner.',
    svgPath: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
    color: '#FE953A',
  },
  {
    num: '05',
    title: 'AI-Accelerated Development',
    summary: 'Faster builds. Smarter content. AI in the pipeline.',
    detail: "We apply AI tools strategically across the development pipeline — from procedural content generation and AI-assisted concept art to dynamic difficulty balancing, intelligent NPC behavior, and code-gen acceleration. This is not about replacing craft; it is about amplifying it. Ship richer games, faster, without blowing your budget.",
    bullets: ['Procedural content & level generation', 'AI-assisted art & asset creation', 'Dynamic difficulty & adaptive systems', 'LLM-powered NPC dialogue & behavior'],
    audience: 'For forward-thinking studios ready to bring AI into their production pipeline.',
    svgPath: 'M12 2a10 10 0 100 20A10 10 0 0012 2zM2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z',
    color: '#E63946',
    isNew: true,
  },
];
---

<section id="services" class="relative section overflow-hidden" style="background: #F4F4F5;">

  <div class="max-w-6xl mx-auto px-6">

    <!-- Heading -->
    <div class="mb-12 reveal-up">
      <Badge variant="orange">What We Do</Badge>
      <div class="mt-4 max-w-3xl">
        <h2 class="text-4xl lg:text-5xl font-black text-[#111111]" style="font-family: var(--font-display);">
          Our Services
        </h2>
        <p class="mt-4 text-base text-[#4B5563] leading-relaxed">
          Kef Sensei is a flexible, senior game development studio. We've been building and
          shipping FUN for nearly two decades — as trusted co-dev partners, as rapid
          prototypers, as full production teams. Pick your challenge. We'll pick our tools.
        </p>
        <p class="mt-3 text-base text-[#4B5563] leading-relaxed">
          Every engagement, we bring the same obsessive focus on craft, communication,
          and player experience — whether we're embedding in a 50-person studio or shipping
          an independent original IP. No hand-holding required.
        </p>
      </div>
      <div class="mt-8 h-px" style="background: linear-gradient(to right, #E63946, #FE953A, transparent);"></div>
    </div>

    <!-- Service cards grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-up">
      {services.map((svc) => (
        <div class="service-card group relative rounded-2xl overflow-hidden cursor-pointer" style="background: #111111; min-height: 400px;">
          <!-- Gradient top accent bar -->
          <div class="h-1.5 w-full" style={`background: linear-gradient(to right, ${svc.color}, #FE953A);`}></div>

          <!-- Front face (always visible) -->
          <div class="service-front p-7 flex flex-col gap-5 h-full transition-all duration-300">
            <!-- Icon + number row -->
            <div class="flex items-start justify-between">
              <div
                class="w-14 h-14 rounded-xl flex items-center justify-center flex-shrink-0"
                style={`background: linear-gradient(135deg, ${svc.color}30, ${svc.color}18); border: 1px solid ${svc.color}50;`}
              >
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke={svc.color} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d={svc.svgPath} />
                </svg>
              </div>
              <div class="flex items-center gap-2">
                {svc.isNew && (
                  <span class="px-2 py-0.5 rounded-full text-xs font-bold text-white" style="background: linear-gradient(135deg, #E63946, #FE953A);">NEW</span>
                )}
                <span class="text-4xl font-black leading-none" style={`font-family: var(--font-display); color: rgba(255,255,255,0.09);`}>{svc.num}</span>
              </div>
            </div>

            <!-- Title + summary -->
            <div class="flex-1">
              <h3 class="text-lg font-bold mb-2" style={`font-family: var(--font-display); color: #FFFFFF;`}>{svc.title}</h3>
              <p class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.72);">{svc.summary}</p>
            </div>

            <!-- Audience tag -->
            <p class="text-xs italic leading-snug border-t pt-3" style="color: rgba(255,255,255,0.45); border-color: rgba(255,255,255,0.1);">{svc.audience}</p>

            <!-- Expand hint -->
            <div class="flex items-center gap-1.5 text-sm font-semibold" style={`color: ${svc.color};`}>
              <span>Learn more</span>
              <svg class="transition-transform duration-300 group-hover:translate-x-1" width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>

          <!-- Hover overlay — expanded detail slides in from bottom -->
          <div
            class="service-back absolute inset-0 flex flex-col justify-between p-7 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
            style={`background: linear-gradient(160deg, #1C1C1C 0%, #111111 100%); border-top: 3px solid ${svc.color};`}
          >
            <div>
              <h3 class="text-base font-bold mb-3" style={`font-family: var(--font-display); color: #FFFFFF;`}>{svc.title}</h3>
              <p class="text-sm leading-relaxed mb-4" style="color: rgba(255,255,255,0.65);">{svc.detail}</p>
              <ul class="space-y-1.5">
                {svc.bullets.map((b) => (
                  <li class="flex items-start gap-2 text-sm" style="color: rgba(255,255,255,0.78);"
                    <span class="mt-1 flex-shrink-0 w-1.5 h-1.5 rounded-full" style={`background: ${svc.color};`}></span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
            <a
              href="/#contact"
              class="inline-flex items-center gap-2 text-xs font-bold mt-4 pt-3 border-t border-white/10 transition-opacity hover:opacity-70"
              style={`color: ${svc.color};`}
            >
              Discuss this service
              <svg width="12" height="12" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      ))}

      <!-- 6th cell: CTA card -->
      <div class="rounded-2xl p-7 flex flex-col justify-between" style="background: linear-gradient(135deg, #E63946 0%, #FE953A 100%); min-height: 400px;">
        <div>
          <div class="text-white/70 text-xs font-bold uppercase tracking-widest mb-3">Not sure which fits?</div>
          <h3 class="text-xl font-black text-white leading-tight" style="font-family: var(--font-display);">Let's figure it out together.</h3>
          <p class="text-white/75 text-sm mt-3 leading-relaxed">Tell us about your game or challenge and we'll point you in the right direction — no pressure, no pitch.</p>
        </div>
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 mt-6 px-5 py-2.5 rounded-full bg-white text-sm font-bold transition-all hover:bg-white/90 self-start"
          style="color: #E63946;"
        >
          Get in touch
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</section>
